{
  "name": "pacto-desktop",
  "version": "0.7.0",
  "description": "Carrossell — carrosséis com estratégia de venda e o método P.A.C.T.O.",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "Matheus Castro",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node mcp/server.mjs",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.5",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openai/codex": "0.163.0",
    "electron-updater": "6.8.11",
    "fflate": "0.8.3",
    "lucide-react": "1.59.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.matheuscastro.pacto",
    "productName": "Carrossell",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "cli/**/*",
      "mcp/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex*/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/branding/carrossell.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Carrossell-${version}-mac-${arch}.${ext}",
      "icon": "resources/branding/carrossell.icns",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Carrossell ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mathpcastro",
        "repo": "pacto-releases",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "Carrossell-Setup-${version}.${ext}",
      "installerIcon": "resources/branding/carrossell.ico",
      "uninstallerIcon": "resources/branding/carrossell.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "cli/bin",
        "to": "bin"
      }
    ]
  },
  "bin": {
    "carrossell": "cli/carrossell.mjs"
  }
}
